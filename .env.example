# Optional overrides; use __ between nested configuration fields. Do not commit .env.
# Values are read from the process environment; this project does not load .env files.
AURORA_LOGGING__LEVEL=DEBUG
AURORA_WLED__ENABLED=false
AURORA_WLED__HOST=
AURORA_WLED__PORT=
AURORA_WLED__VALIDATION_TIMEOUT_SECONDS=2.0
# AURORA_WLED__EXPECTED_LED_COUNT=
# AURORA_WLED__EXPECTED_ACTIVE_LED_COUNT=
# AURORA_WLED__EXPECTED_SKIPPED_LEDS=
AURORA_HYPERHDR__ENABLED=false
AURORA_HYPERHDR__HOST=
AURORA_HYPERHDR__PORT=
AURORA_HYPERHDR__VALIDATION_TIMEOUT_SECONDS=2.0
AURORA_CAPTURE_DEVICE__ENABLED=false
# AURORA_CAPTURE_DEVICE__IDENTIFIER=/dev/v4l/by-id/REPLACE_WITH_STABLE_DEVICE_NAME
AURORA_DASHBOARD__BIND_HOST=localhost
AURORA_DASHBOARD__PORT=8080
AURORA_DASHBOARD__REFRESH_SECONDS=5
AURORA_DASHBOARD__CPU_TEMPERATURE_WARNING_C=80.0
AURORA_DASHBOARD__MEMORY_WARNING_PERCENT=90.0
AURORA_DASHBOARD__STORAGE_WARNING_PERCENT=90.0
AURORA_MQTT__USERNAME=
AURORA_MQTT__PASSWORD=

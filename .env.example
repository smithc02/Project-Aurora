# Optional overrides; use __ between nested configuration fields. Do not commit .env.
# Values are read from the process environment; this project does not load .env files.
AURORA_LOGGING__LEVEL=DEBUG
AURORA_WLED__ENABLED=false
AURORA_WLED__HOST=
AURORA_WLED__PORT=
AURORA_WLED__VALIDATION_TIMEOUT_SECONDS=2.0
# AURORA_WLED__EXPECTED_LED_COUNT=
# AURORA_WLED__EXPECTED_ACTIVE_LED_COUNT=
# AURORA_WLED__EXPECTED_SKIPPED_LEDS=
# WLED controls require authentication, this switch, and this exact allowlist.
AURORA_WLED__CONTROLS__ENABLED=false
AURORA_WLED__CONTROLS__ALLOWED_OPERATIONS=
AURORA_WLED__CONTROLS__TIMEOUT_SECONDS=2.0
AURORA_WLED__CONTROLS__MAXIMUM_BRIGHTNESS=255
AURORA_WLED__CONTROLS__OPERATION_LIMIT=20
AURORA_WLED__CONTROLS__OPERATION_WINDOW_SECONDS=60
AURORA_HYPERHDR__ENABLED=false
AURORA_HYPERHDR__HOST=
AURORA_HYPERHDR__PORT=
AURORA_HYPERHDR__VALIDATION_TIMEOUT_SECONDS=2.0
AURORA_CAPTURE_DEVICE__ENABLED=false
# AURORA_CAPTURE_DEVICE__IDENTIFIER=/dev/v4l/by-id/REPLACE_WITH_STABLE_DEVICE_NAME
AURORA_DASHBOARD__BIND_HOST=localhost
AURORA_DASHBOARD__PORT=8080
AURORA_DASHBOARD__REFRESH_SECONDS=5
AURORA_DASHBOARD__CPU_TEMPERATURE_WARNING_C=80.0
AURORA_DASHBOARD__MEMORY_WARNING_PERCENT=90.0
AURORA_DASHBOARD__STORAGE_WARNING_PERCENT=90.0
# Authentication is disabled by default. Do not commit operator or hash values.
AURORA_DASHBOARD__AUTHENTICATION__ENABLED=false
# AURORA_DASHBOARD__AUTHENTICATION__USERNAME=<operator-name>
# AURORA_DASHBOARD__AUTHENTICATION__PASSWORD_HASH=<generated-versioned-hash>
AURORA_DASHBOARD__AUTHENTICATION__SESSION_TTL_MINUTES=480
AURORA_DASHBOARD__AUTHENTICATION__MAXIMUM_SESSIONS=16
AURORA_DASHBOARD__AUTHENTICATION__SECURE_COOKIE=false
AURORA_DASHBOARD__AUTHENTICATION__LOGIN_ATTEMPT_LIMIT=5
AURORA_DASHBOARD__AUTHENTICATION__LOGIN_ATTEMPT_WINDOW_SECONDS=300
AURORA_MQTT__USERNAME=
AURORA_MQTT__PASSWORD=
